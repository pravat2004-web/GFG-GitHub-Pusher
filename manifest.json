{
    "manifest_version": 3,
    "name": "GFG GitHub Pusher",
    "version": "2.0.1",
    "description": "Push GeeksforGeeks solutions directly to GitHub",

    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],

    "host_permissions": [
        "https://www.geeksforgeeks.org/*",
        "https://api.github.com/*"
    ],

    "action": {
        "default_popup": "popup.html"
    },

    "content_scripts": [
        {
            "matches": [
                "https://www.geeksforgeeks.org/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}